# Path of the SQLite database built by `npm run ingest` (relative to the project root).
DATABASE_PATH=data/compass.db

# Embedding model (Hugging Face id). all-MiniLM-L6-v2 is small (~23 MB quantized) and fast on CPU.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Optional: directory that already contains the model files (config.json, tokenizer.json,
# onnx/model_quantized.onnx) laid out as <dir>/Xenova/all-MiniLM-L6-v2/... . When set, no
# network access is needed to load the model. Leave unset to download from the Hugging Face Hub
# on first use (cached under data/models/).
# EMBEDDING_MODEL_DIR=data/models

# Optional: override where downloaded source texts live.
# DATA_RAW_DIR=data/raw
